# Postgres connection string (Neon). Used by the app and by npm run db:migrate / db:seed.
DATABASE_URL=

# Random string, at least 32 characters. Signs admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: the public site address, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Only used by npm run db:seed to create the first owner login.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
